{
  "name": "@tolt/embed",
  "version": "0.2.0",
  "description": "Drop a partner's referral dashboard into your app with one React component.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/react": "^18.3.12",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "react": "^18.3.1",
    "semantic-release": "^25.0.9",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "tolt",
    "referral",
    "affiliate",
    "embed",
    "react",
    "dashboard"
  ],
  "homepage": "https://github.com/toltapp/tolt-embed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toltapp/tolt-embed.git"
  },
  "bugs": {
    "url": "https://github.com/toltapp/tolt-embed/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.2"
    }
  }
}
