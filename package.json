{
  "name": "@tolt/embed",
  "version": "0.1.0",
  "description": "Drop a partner's referral dashboard into your app with one React component.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "tolt",
    "referral",
    "affiliate",
    "embed",
    "react",
    "dashboard"
  ],
  "homepage": "https://github.com/toltapp/tolt-embed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toltapp/tolt-embed.git"
  },
  "bugs": {
    "url": "https://github.com/toltapp/tolt-embed/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
